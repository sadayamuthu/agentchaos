{
  "mcpServers": {
    "crm": {
      "command": "./examples/bin/agentchaos",
      "args": [
        "proxy",
        "--experiment",
        "./paper/pilot/data/sonnet/experiment.yaml",
        "--name",
        "orders.get malformed",
        "--server",
        "crm",
        "--trace",
        "./paper/pilot/data/sonnet/orders-get-malformed/6/trace-crm.jsonl",
        "--log",
        "./paper/pilot/data/sonnet/orders-get-malformed/6/proxy-crm.log",
        "--",
        "./examples/bin/crm-server"
      ],
      "env": {}
    },
    "orders": {
      "command": "./examples/bin/agentchaos",
      "args": [
        "proxy",
        "--experiment",
        "./paper/pilot/data/sonnet/experiment.yaml",
        "--name",
        "orders.get malformed",
        "--server",
        "orders",
        "--trace",
        "./paper/pilot/data/sonnet/orders-get-malformed/6/trace-orders.jsonl",
        "--log",
        "./paper/pilot/data/sonnet/orders-get-malformed/6/proxy-orders.log",
        "--",
        "./examples/bin/orders-server"
      ],
      "env": {}
    }
  }
}
